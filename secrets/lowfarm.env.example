# LowFarm secrets — TEMPLATE.  Copy to lowfarm.env and fill in, or run
#   make secrets
# which generates cryptographically random values for every entry.
#
# NEVER commit lowfarm.env.

# --- Gateway (public plane) ---------------------------------------------
# Bearer token for /v1/*.  Comma-separate to keep an old key valid during
# a rotation window, e.g. "newkey,oldkey".
GATEWAY_API_KEY=

# --- Gateway (admin / control plane) ------------------------------------
# Bearer token for /v1/admin/*.  Rotate independently of the public key.
ADMIN_API_KEY=

# --- Workers ------------------------------------------------------------
# Shared key the workers use to call the gateway's admin plane.
WORKER_ADMIN_KEY=

# --- Per-client keys ----------------------------------------------------
# Optional extra keys with their own quota, created through
# POST /v1/admin/clients.  The gateway stores only their SHA-256 hash, so
# they do not need to live here.

# --- Observability -------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Optional bootstrap --------------------------------------------------
# Comma-separated entries; fields within an entry separated by "|".
# Only used when the registry is empty — dynamic registration is primary.
# The mock fleet in docker-compose.yml registers itself on boot, so this is
# normally left empty.
# WORKER_SEEDS=http://mock-1:8080|qwen2.5-0.5b-instruct-q4_k_m|mock-1
