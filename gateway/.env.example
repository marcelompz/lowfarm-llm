# REFERENCE of every gateway setting, with its default.
#
# The real configuration lives in secrets/lowfarm.env (gitignored, mode
# 0600), which is the file the compose stack reads:
#
#   make secrets   # generate it with 256-bit random values
#   make up        # docker compose --env-file secrets/lowfarm.env up -d
#
# This file documents the knobs; it is not the one to copy.

# --- Required -----------------------------------------------------------
# Comma-separated: several keys stay valid at once (rotation window).
GATEWAY_API_KEY=
ADMIN_API_KEY=

# --- Core ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Secret hygiene -----------------------------------------------------
# Refuse to boot on a placeholder key.
REQUIRE_STRONG_KEYS=false
MIN_KEY_LENGTH=24
# Read the keys from a mounted file instead (Docker secrets in production).
# GATEWAY_API_KEY_FILE=/run/secrets/gateway_api_key
# ADMIN_API_KEY_FILE=/run/secrets/admin_api_key

# --- Bootstrap (optional) ----------------------------------------------
# Comma-separated; fields within an entry separated by "|".
# Only used when the registry is empty — dynamic registration is primary.
# WORKER_SEEDS=http://192.168.1.101:8080|qwen2.5-0.5b-instruct-q4_k_m|a30-01

# --- Scheduling ---------------------------------------------------------
SCHEDULING_POLICY=least_outstanding
DEFAULT_SLOTS_PER_WORKER=4
SESSION_TTL=3600
STREAM_QUEUE_TIMEOUT=120

# --- Health -------------------------------------------------------------
HEALTH_CHECK_INTERVAL=10
HEALTH_PROBE_TIMEOUT=3
HEALTH_FAILURE_THRESHOLD=3
HEALTH_RECOVERY_THRESHOLD=2
HALF_OPEN_PROBE_INTERVAL=30
WORKER_STALE_TTL=45

# --- Streaming ----------------------------------------------------------
STREAM_HEARTBEAT_INTERVAL=15
UPSTREAM_REQUEST_TIMEOUT=300
MAX_RETRIES=2

# --- Thermal ------------------------------------------------------------
THERMAL_SOFT_LIMIT_C=45
THERMAL_HARD_LIMIT_C=52

# --- Chat history -------------------------------------------------------
CHAT_HISTORY_ENABLED=true
CHAT_HISTORY_MAX_MESSAGES=40
CHAT_HISTORY_TTL=86400

# --- Client quotas ------------------------------------------------------
QUOTAS_ENABLED=true
DEFAULT_RPM_LIMIT=60
DEFAULT_TPM_LIMIT=100000
DEFAULT_MAX_CONCURRENCY=8
QUOTA_WINDOW_SECONDS=60
QUOTA_TOKEN_ESTIMATE_RATIO=4
